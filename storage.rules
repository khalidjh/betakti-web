rules_version = '2';

// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    match /template-thumbnails/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    match /thumbnails/{projectId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /assets/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    // Images the user drops onto a canvas. Public read because the editor, the
    // export canvas and (later) share pages all load them without credentials;
    // writes are scoped to the owner's own folder.
    match /uploads/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // `request.resource` is null on a delete, so it gets its own clause.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
