# ======================================================================
# Betakti Web — Environment Variables
# Copy this file to .env.local and fill in the values.
# PUBLIC_* values are exposed to the browser. Keep secrets unprefixed.
# ======================================================================

# ---------- App ----------
# Canonical origin used for SEO (canonical, hreflang, sitemap, og). No trailing slash.
# Production: set this in Vercel to the live domain.
PUBLIC_APP_URL=https://betakti.com
PUBLIC_DEFAULT_LOCALE=ar

# ---------- Firebase (client SDK) ----------
# From Firebase console → Project settings → General → Your apps (Web)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
# Required for Firebase Analytics (Project settings → Web app → measurementId, "G-…").
PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- Firebase Admin SDK (server-only) ----------
# From Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the full private_key. Newlines must be escaped as \n (or wrap the whole value in single quotes).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------- Moyasar (payments) ----------
# Dashboard → Settings → API keys. Use test keys in development.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ---------- Pexels (stock photos, Phase 2) ----------
PEXELS_API_KEY=

# ---------- fal.ai (AI Style Transfer, Phase 3) ----------
FAL_API_KEY=

# ---------- Google Fonts (optional; only if using API key for higher quotas) ----------
GOOGLE_FONTS_API_KEY=
